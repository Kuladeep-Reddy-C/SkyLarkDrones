# ---- Monday.com ----
# Personal API token (Monday: Profile > Developers > My access tokens)
MONDAY_API_TOKEN=your_monday_token_here
MONDAY_API_VERSION=2024-10
# Filled in automatically by `npm run import`. Can also be left blank and the
# agent will resolve boards by name (MONDAY_DEALS_BOARD_NAME / _WORK_ORDERS_BOARD_NAME).
MONDAY_DEALS_BOARD_ID=
MONDAY_WORK_ORDERS_BOARD_ID=
MONDAY_DEALS_BOARD_NAME=Deals
MONDAY_WORK_ORDERS_BOARD_NAME=Work Orders
MONDAY_WORKSPACE_ID=3380356

# ---- LLM (Groq - OpenAI compatible) ----
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# ---- Server ----
PORT=8080
# Comma separated list of allowed origins for CORS (frontend URLs)
CORS_ORIGINS=http://localhost:5173

# ---- Data cache ----
# How long (seconds) the in-memory snapshot of Monday data is considered fresh
DATA_CACHE_TTL_SECONDS=300
